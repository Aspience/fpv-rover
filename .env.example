# --- Backend (ROVER_* prefix, read by pydantic-settings) ---

# Feature flags
ROVER_MODULES_POWER_ENABLED=false
ROVER_MODULES_MOTION_ENABLED=false
ROVER_MODULES_THERMAL_ENABLED=false
ROVER_MODULES_IMU_ENABLED=false
ROVER_MODULES_LIGHT_ENABLED=false
ROVER_MODULES_TOF_ENABLED=false
ROVER_MODULES_CAMERA_ENABLED=false
ROVER_MODULES_BLUETOOTH_ENABLED=false
ROVER_MODULES_GAMEPAD_ENABLED=false

# pigpio sidecar (docker-compose service name)
ROVER_PIGPIO_HOST=pigpiod
ROVER_PIGPIO_PORT=8888

# Motion — TB6612FNG × 3 (front / rear / steer); BCM GPIO map in SCHEMA.md
ROVER_MOTION_FRONT_PWMA_GPIO=18
ROVER_MOTION_FRONT_AIN1_GPIO=23
ROVER_MOTION_FRONT_AIN2_GPIO=24
ROVER_MOTION_FRONT_TACHO_A_GPIO=17
ROVER_MOTION_FRONT_TACHO_B_GPIO=27
ROVER_MOTION_REAR_PWMA_GPIO=12
ROVER_MOTION_REAR_AIN1_GPIO=16
ROVER_MOTION_REAR_AIN2_GPIO=20
ROVER_MOTION_REAR_TACHO_A_GPIO=5
ROVER_MOTION_REAR_TACHO_B_GPIO=6
ROVER_MOTION_STEER_PWMA_GPIO=13
ROVER_MOTION_STEER_AIN1_GPIO=19
ROVER_MOTION_STEER_AIN2_GPIO=26
ROVER_MOTION_STEER_TACHO_A_GPIO=21
ROVER_MOTION_STEER_TACHO_B_GPIO=22
ROVER_MOTION_MAX_SPEED_TICKS=800
ROVER_MOTION_STEER_MAX_DEG=45
ROVER_MOTION_PID_KP=0.8
ROVER_MOTION_PID_KI=0.05
ROVER_MOTION_PID_KD=0.01

# Global
ROVER_LOG_LEVEL=INFO
ROVER_HOST=0.0.0.0
ROVER_PORT=8000
ROVER_WS_TELEMETRY_HZ=20
ROVER_HEARTBEAT_TIMEOUT_SEC=1.0
ROVER_IO_RETRY_DELAY_SEC=2.0

# MediaMTX
ROVER_MEDIAMTX_API_URL=http://mediamtx:9997
ROVER_MEDIAMTX_RECORD_START_PATH=/v3/recordings/start/{stream_path}
ROVER_MEDIAMTX_RECORD_STOP_PATH=/v3/recordings/stop/{stream_path}
ROVER_MEDIAMTX_STREAM_CONFIG_PATH=/v3/config/paths/patch/{stream_path}
ROVER_MEDIAMTX_STREAM_CONFIG_GET_PATH=/v3/config/paths/get/{stream_path}

# Hardware — I2C bus (GPIO2 SDA / GPIO3 SCL; see SCHEMA.md)
ROVER_I2C_BUS=1

# Hardware — power, main board (INA219)
ROVER_POWER_I2C_ADDRESS=0x40

# Hardware — IMU, main board (GY-521 / MPU6050)
ROVER_IMU_I2C_ADDRESS=0x68

# Hardware — light, expansion board (GY-302 / BH1750)
ROVER_LIGHT_I2C_ADDRESS=0x23

# Hardware — TOF, expansion board (TOF400C × 4)
ROVER_TOF1_XSHUT_GPIO=7
ROVER_TOF2_XSHUT_GPIO=8
ROVER_TOF3_XSHUT_GPIO=10
ROVER_TOF4_XSHUT_GPIO=25
ROVER_TOF1_I2C_ADDRESS=0x52
ROVER_TOF2_I2C_ADDRESS=0x53
ROVER_TOF3_I2C_ADDRESS=0x54
ROVER_TOF4_I2C_ADDRESS=0x55

# Hardware — thermal, 1-Wire (DS18B20)
ROVER_W1_GPIO=4
ROVER_W1_BASE_PATH=/sys/bus/w1/devices
ROVER_THERMAL_W1_SLAVE_FILE=w1_slave
ROVER_THERMAL_SENSOR_IDS={"motor_steering":"28-000000000001","motor_front":"28-000000000002","motor_rear":"28-000000000003","bms":"28-000000000004","iflight_bec":"28-000000000005","tp5100":"28-000000000006"}

# Hardware — camera (Arducam IMX462, CSI to Pi)
ROVER_CAMERA_V4L2_DEVICE=/dev/video0
ROVER_CAMERA_V4L2_CTL_BIN=v4l2-ctl
ROVER_CAMERA_STREAM_PATH=rover

# --- Frontend (VITE_* — build-time, read by Vite) ---
VITE_RPI_HOST=localhost
VITE_API_PORT=8000
VITE_WEBRTC_PORT=8889

# --- OTA / Docker Compose (production) ---

ROVER_APP_VERSION=0.1.0
ROVER_GITHUB_OWNER=aspience
ROVER_GITHUB_REPO=fpv-rover
ROVER_GITHUB_TOKEN=
ROVER_OTA_ENABLED=false
ROVER_OTA_INSTALL_DIR=/opt/fpv-rover
ROVER_OTA_SCRIPT=/opt/fpv-rover/scripts/ota_update.sh
# Host path to deploy key on the device (bootstrap sets $HOME/.ssh/fpv_rover_deploy for the current user)
ROVER_OTA_SSH_KEY_PATH=

FPV_ROVER_IMAGE_REGISTRY=ghcr.io
IMAGE_TAG=latest
PIGPIOD_IMAGE=zinen2/alpine-pigpiod:pigpio-v79

# Per-service image tags (used by docker compose and shown in Settings UI; auto-resolved from image-tags.env on deploy)
# BACKEND_IMAGE_TAG=
# FRONTEND_IMAGE_TAG=
# MEDIAMTX_IMAGE_TAG=
